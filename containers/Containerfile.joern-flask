# Local offline qualification layer; runner records immutable image identity.
ARG JOERN_BASE=veriflow:joern-linux-poc
FROM ${JOERN_BASE}
USER 0
COPY dist/veriflow-0.1.0-py3-none-any.whl /tmp/veriflow-0.1.0-py3-none-any.whl
RUN /opt/veriflow-venv/bin/pip install --no-index --no-deps --force-reinstall /tmp/veriflow-0.1.0-py3-none-any.whl
COPY scripts/validate_joern_flask.py /opt/veriflow/scripts/
COPY tests/fixtures/joern-flask /opt/veriflow/tests/fixtures/joern-flask
USER 1001:0
